    "entraAdminName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Display name of the shared Entra ID administrator principal."
      }
    },
    "entraAdminPrincipalType": {
      "type": "string",
      "defaultValue": "ServicePrincipal",
      "metadata": {
        "description": "Principal type of the Entra ID administrator: ServicePrincipal, User, or Group."
      }
    }
  },
  "variables": {
    "prefix": "[format('{0}-{1}', parameters('appName'), parameters('environment'))]",
    "tags": {
      "project": "Natya Theerth Kalai Koodam",
      "environment": "[parameters('environment')]",
      "managedBy": "Bicep"
    },
    "storageAccountName": "[take(replace(format('{0}{1}stor', parameters('appName'), parameters('environment')), '-', ''), 24)]"
