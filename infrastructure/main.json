                      "name": "JWT_SECRET",
                      "value": "[parameters('jwtSecret')]"
                    },
                    {
                      "name": "ADMIN_EMAIL",
                      "value": "[parameters('adminEmail')]"
                    },
                    {
                      "name": "EMAIL_FROM",
                      "value": "[parameters('adminEmail')]"
                    }
                  ],
                  "cors": {
                    "allowedOrigins": [
                      "https://natyatheerth.ca",
                      "https://www.natyatheerth.ca"
                    ],
                    "supportCredentials": true
                  },
                  "nodeVersion": "~18"
