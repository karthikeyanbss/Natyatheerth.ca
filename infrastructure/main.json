                  "geoRedundantBackup": "Disabled"
                },
                "highAvailability": {
                  "mode": "Disabled"
                },
                "authConfig": {
                  "activeDirectoryAuth": "[if(variables('enableEntraAuth'), 'Enabled', 'Disabled')]",
                  "passwordAuth": "Enabled",
                  "tenantId": "[if(variables('enableEntraAuth'), parameters('entraAdminTenantId'), null())]"
                }
              }
            },
            {
              "condition": "[variables('enableEntraAuth')]",
