              "defaultValue": "ServicePrincipal",
              "metadata": {
                "description": "Principal type of the Entra ID administrator: ServicePrincipal, User, or Group."
              }
            }
          },
          "variables": {
            "enableEntraAuth": "[and(and(not(empty(parameters('entraAdminObjectId'))), not(empty(parameters('entraAdminTenantId')))), not(empty(parameters('entraAdminName'))))]"
          },
          "resources": [
            {
              "type": "Microsoft.DBforPostgreSQL/flexibleServers",
